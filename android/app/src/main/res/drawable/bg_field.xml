<?xml version="1.0" encoding="utf-8"?>
<!--
    输入框底：聚焦时描边变粗并换成主色，给一个明确的"我正在编辑这里"的反馈。
    覆盖 background 会让 EditText 丢掉自带内边距，所以在布局里显式补了 padding。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/md_primary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/md_outline_variant" />
        </shape>
    </item>

</selector>
